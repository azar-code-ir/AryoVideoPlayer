<Application x:Class="AryoVideoPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AryoVideoPlayer"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- تم تیره سفارشی -->
            <SolidColorBrush x:Key="DarkBackground" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="MediumBackground" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="LightBackground" Color="#3D3D3D"/>
            <SolidColorBrush x:Key="AccentColor" Color="#6C63FF"/>
            <SolidColorBrush x:Key="SilverButton" Color="#C0C0C0"/>

            <!-- فونت Pinar -->
            <FontFamily x:Key="PinarFont">pack://application:,,,/Fonts/#Pinar</FontFamily>
            <FontFamily x:Key="PinarBold">pack://application:,,,/Fonts/#Pinar Bold</FontFamily>

            <!-- اعمال فونت به کل اپلیکیشن -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
