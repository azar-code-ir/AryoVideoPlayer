<Window x:Class="AryoVideoPlayer.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aryo" Height="500" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Color="Black" Opacity="0.7"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="17" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" HorizontalAlignment="Right"
                        Click="CloseBtn_Click" Width="28" Height="28" FontSize="11" Padding="0"
                        Background="Transparent" Foreground="#999" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                          Background="Transparent" Padding="0,0,6,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="#7C6AFF" x:Name="IconBorder" Margin="0,4,0,0">
                            <TextBlock x:Name="IconText" Text="i" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="MessageText" Grid.Column="1" FontSize="15"
                                   Foreground="#CCC" VerticalAlignment="Top" TextWrapping="Wrap"
                                   Margin="16,0,0,0" LineHeight="24"/>
                    </Grid>
                    <TextBox x:Name="InputBox" FontSize="15" Foreground="White" Background="#2A2A2A"
                             BorderBrush="#444" BorderThickness="1" Padding="10,8" Margin="0,12,0,0"
                             Visibility="Collapsed" CaretBrush="White" MaxLength="20"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OkButton" Content="باشه" Click="OkBtn_Click" MinWidth="80"
                        Background="#7C6AFF" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Padding="24,8" FontSize="13" FontWeight="Bold"/>
                <Button x:Name="CancelButton" Content="لغو" Click="CancelBtn_Click" MinWidth="80"
                        Background="#333" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                        Padding="24,8" FontSize="13" Margin="8,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="YesButton" Content="بله" Click="YesBtn_Click" MinWidth="80"
                        Background="#7C6AFF" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Padding="24,8" FontSize="13" FontWeight="Bold" Visibility="Collapsed"/>
                <Button x:Name="NoButton" Content="خیر" Click="NoBtn_Click" MinWidth="80"
                        Background="#333" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                        Padding="24,8" FontSize="13" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
