<Window x:Class="AryoVideoPlayer.AudioToTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="method ariyo v1" Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1A1A1E" CornerRadius="12" BorderBrush="#333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Color="Black" Opacity="0.8"/>
        </Border.Effect>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,16,0,12">
                    <Border Background="#7C6AFF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="method ariyo v1" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="ترجمه خودکار زیرنویس ویدیو" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="CloseBtn_Click" Width="30" Height="30"
                        Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand" 
                        FontSize="11" Margin="0,12,16,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ویدیوی فعلی -->
                <Border Grid.Row="0" Background="#222226" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#7C6AFF" CornerRadius="6" 
                                Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="🎬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ویدیوی در حال پخش" Foreground="#666" FontSize="10" Margin="0,0,0,2"/>
                            <TextBlock x:Name="VideoNameText" Text="هیچ ویدیویی پخش نیست" Foreground="White" FontSize="12"
                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- زبان‌ها -->
                <Border Grid.Row="1" Background="#222226" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="زبان ویدیو" Foreground="#666" FontSize="10" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SourceLangComboBox" Background="#2A2A2E" Foreground="#CCC"
                                      BorderBrush="#3A3A3E" BorderThickness="1" Height="32" FontSize="12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="انگلیسی"/>
                                <ComboBoxItem Content="فارسی"/>
                                <ComboBoxItem Content="فرانسوی"/>
                                <ComboBoxItem Content="آلمانی"/>
                                <ComboBoxItem Content="اسپانیایی"/>
                                <ComboBoxItem Content="ایتالیایی"/>
                                <ComboBoxItem Content="ژاپنی"/>
                                <ComboBoxItem Content="کره‌ای"/>
                                <ComboBoxItem Content="چینی"/>
                                <ComboBoxItem Content="عربی"/>
                                <ComboBoxItem Content="ترکی"/>
                                <ComboBoxItem Content="روسی"/>
                            </ComboBox>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#7C6AFF" CornerRadius="12" 
                                Width="28" Height="28" VerticalAlignment="Bottom" Margin="0,0,0,2">
                            <TextBlock Text="→" FontSize="14" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="زبان ترجمه" Foreground="#666" FontSize="10" Margin="0,0,0,6"/>
                            <ComboBox x:Name="TargetLangComboBox" Background="#2A2A2E" Foreground="#CCC"
                                      BorderBrush="#3A3A3E" BorderThickness="1" Height="32" FontSize="12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="فارسی"/>
                                <ComboBoxItem Content="انگلیسی"/>
                                <ComboBoxItem Content="فرانسوی"/>
                                <ComboBoxItem Content="آلمانی"/>
                                <ComboBoxItem Content="اسپانیایی"/>
                                <ComboBoxItem Content="ایتالیایی"/>
                                <ComboBoxItem Content="ژاپنی"/>
                                <ComboBoxItem Content="کره‌ای"/>
                                <ComboBoxItem Content="چینی"/>
                                <ComboBoxItem Content="عربی"/>
                                <ComboBoxItem Content="ترکی"/>
                                <ComboBoxItem Content="روسی"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- لاگ -->
                <Border Grid.Row="2" Background="#161618" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="LogScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" Text="" Foreground="#444" FontSize="10" 
                                       FontFamily="Consolas" TextWrapping="Wrap" LineHeight="18"/>
                        </ScrollViewer>
                        <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="3" Background="#2A2A2E"
                                     Foreground="#7C6AFF" BorderThickness="0" Margin="0,8,0,0"
                                     Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- دکمه‌ها -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TranslateBtn" Grid.Column="1" Click="TranslateBtn_Click"
                            Background="#7C6AFF" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Padding="24,11" FontSize="13" FontWeight="SemiBold" MinWidth="150">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ترجمه ویدیو" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="0" Content="بستن" Click="CloseBtn_Click" 
                            Style="{StaticResource SmallBtn}" HorizontalAlignment="Left"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
