<Window x:Class="AryoVideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AryoVideoPlayer"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Aryo Video Player" 
        Height="750" Width="1280"
        MinHeight="500" MinWidth="850"
        Background="#0D0D0D"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        WindowStyle="None"
        StateChanged="Window_StateChanged"
        Icon="Assets/logo.png"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7C6AFF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#9B8AFF"/>
        <SolidColorBrush x:Key="SeekBarFill" Color="#7C6AFF"/>
        <SolidColorBrush x:Key="SeekBarBg" Color="#333333"/>

        <!-- سایه منو -->
        <DropShadowEffect x:Key="MenuShadow" BlurRadius="20" Direction="270" 
                          Color="Black" Opacity="0.6" ShadowDepth="5"/>

        <!-- استایل منوی بالا - بدون ControlTemplate -->
        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#25FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- آیتم‌های dropdown منوی بالا - بدون ControlTemplate -->
        <Style x:Key="TopMenuItemSub" TargetType="MenuItem">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- دکمه منوی بالا -->
        <Style x:Key="TopMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- آیتم منوی راست کلیک -->
        <Style x:Key="ContextMenuItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource PinarFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CtrlBtn -->
        <Style x:Key="CtrlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PlayBtn -->
        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource CtrlBtn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider - بدون ControlTemplate سفارشی -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource ModernSlider}">
            <Setter Property="Width" Value="120"/>
        </Style>

        <!-- TitleBar Buttons -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item -->
        <Style x:Key="PlaylistItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== نوار عنوان + منو ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#141414">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="Assets/logo.png" Width="16" Height="16" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Aryo Video Player" FontSize="12" FontWeight="SemiBold" 
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="FileNameText" Text="" FontSize="11" Foreground="#666"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Style="{StaticResource TitleBtn}" Click="Minimize_Click" Padding="14,8" Height="34" Width="46"/>
                    <Button x:Name="MaximizeBtn" Content="☐" Style="{StaticResource TitleBtn}" Click="Maximize_Click" Padding="14,8" Height="34" Width="46"/>
                    <Button Content="✕" Style="{StaticResource CloseBtn}" Click="Close_Click" Padding="14,8" Height="34" Width="46"/>
                </StackPanel>
            </Grid>

            <!-- Menu Bar سفارشی -->
            <Grid Grid.Row="1" Background="#141414">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- فایل -->
                <Button Grid.Column="0" Content="فایل" Style="{StaticResource TopMenuBtn}"
                        Click="MenuFile_Click" x:Name="MenuFileBtn"/>
                <!-- نمایش -->
                <Button Grid.Column="1" Content="نمایش" Style="{StaticResource TopMenuBtn}"
                        Click="MenuView_Click" x:Name="MenuViewBtn"/>
                <!-- ابزارها -->
                <Button Grid.Column="2" Content="ابزارها" Style="{StaticResource TopMenuBtn}"
                        Click="MenuTools_Click" x:Name="MenuToolsBtn"/>
                <!-- راهنما -->
                <Button Grid.Column="3" Content="راهنما" Style="{StaticResource TopMenuBtn}"
                        Click="MenuHelp_Click" x:Name="MenuHelpBtn"/>
            </Grid>

            <!-- Popup فایل -->
            <Popup x:Name="PopupFile" AllowsTransparency="True" PopupAnimation="Fade"
                   Placement="Bottom" StaysOpen="False" Opened="Popup_Opened"
                   PlacementTarget="{Binding ElementName=MenuFileBtn}">
                <Border Background="#1E1E1E" CornerRadius="8" Padding="4"
                        BorderBrush="#333" BorderThickness="1" MinWidth="240"
                        Effect="{StaticResource MenuShadow}" Margin="0,4,0,0">
                    <StackPanel>
                        <Button Content="📂  باز کردن..." Click="OpenButton_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="📝  افزودن زیرنویس..." Click="AddSubtitleButton_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Background="#333" Height="1" Margin="4,4"/>
                        <Button Content="📷  ذخیره عکس..." Click="ScreenshotButton_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Background="#333" Height="1" Margin="4,4"/>
                        <Button Content="❌  خروج" Click="Close_Click" Style="{StaticResource ContextMenuItem}"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Popup نمایش -->
            <Popup x:Name="PopupView" AllowsTransparency="True" PopupAnimation="Fade"
                   Placement="Bottom" StaysOpen="False" Opened="Popup_Opened"
                   PlacementTarget="{Binding ElementName=MenuViewBtn}">
                <Border Background="#1E1E1E" CornerRadius="8" Padding="4"
                        BorderBrush="#333" BorderThickness="1" MinWidth="240"
                        Effect="{StaticResource MenuShadow}" Margin="0,4,0,0">
                    <StackPanel>
                        <Button Content="📋  لیست پخش" Click="PlaylistToggle_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Background="#333" Height="1" Margin="4,4"/>
                        <Button Content="⛶  تمام صفحه" Click="FullscreenButton_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="🎬  حالت سینمایی" Click="CinemaMode_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="🌙  حالت شب" Click="NightMode_Click" Style="{StaticResource ContextMenuItem}"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Popup ابزارها -->
            <Popup x:Name="PopupTools" AllowsTransparency="True" PopupAnimation="Fade"
                   Placement="Bottom" StaysOpen="False" Opened="Popup_Opened"
                   PlacementTarget="{Binding ElementName=MenuToolsBtn}">
                <Border Background="#1E1E1E" CornerRadius="8" Padding="4"
                        BorderBrush="#333" BorderThickness="1" MinWidth="240"
                        Effect="{StaticResource MenuShadow}" Margin="0,4,0,0">
                    <StackPanel>
                        <Button Content="⚡  سرعت پخش" Click="SpeedBtn_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="📐  نسبت تصویر" Click="AspectRatio_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Background="#333" Height="1" Margin="4,4"/>
                        <Button Content="🔊  ترک صدا" Click="AudioTrack_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="🎬  ترک ویدیو" Click="VideoTrack_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Background="#333" Height="1" Margin="4,4"/>
                        <Button Content="🎨  فیلتر ویدیو" Click="VideoFilter_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="⏱  تنظیم زیرنویس" Click="SubtitleSync_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Background="#333" Height="1" Margin="4,4"/>
                        <Button Content="🌐  ترجمه ویدیو" Click="AudioToText_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="🔄  تکرار" Click="LoopBtn_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="🔀  پخش تصادفی" Click="ShuffleBtn_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Background="#333" Height="1" Margin="4,4"/>
                        <Button Content="⏰  پرش به زمان" Click="JumpToTime_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="💾  ذخیره لیست پخش" Click="SavePlaylist_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="📂  بارگذاری لیست پخش" Click="LoadPlaylist_Click" Style="{StaticResource ContextMenuItem}"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Popup راهنما -->
            <Popup x:Name="PopupHelp" AllowsTransparency="True" PopupAnimation="Fade"
                   Placement="Bottom" StaysOpen="False" Opened="Popup_Opened"
                   PlacementTarget="{Binding ElementName=MenuHelpBtn}">
                <Border Background="#1E1E1E" CornerRadius="8" Padding="4"
                        BorderBrush="#333" BorderThickness="1" MinWidth="240"
                        Effect="{StaticResource MenuShadow}" Margin="0,4,0,0">
                    <StackPanel>
                        <Button Content="ℹ  اطلاعات ویدیو" Click="InfoButton_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="⌨  کلیدهای میانبر" Click="ShortcutsHelp_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Border Height="1" Background="#333" Margin="8,4"/>
                        <Button Content="📖  درباره ما" Click="AboutUs_Click" Style="{StaticResource ContextMenuItem}"/>
                        <Button Content="📩  ارتباط با ما" Click="ContactUs_Click" Style="{StaticResource ContextMenuItem}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- ===== محتوا ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ویدیو -->
            <Grid x:Name="VideoContainer" Grid.Column="0" Background="Black"
                  MouseEnter="VideoArea_MouseEnter" MouseLeave="VideoArea_MouseLeave"
                  MouseMove="VideoArea_MouseMove">
                <vlc:VideoView x:Name="VideoView"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               Visibility="Collapsed"/>

                <!-- زیرنویس -->
                <Grid x:Name="SubtitleOverlay" IsHitTestVisible="False" VerticalAlignment="Bottom" Margin="0,0,0,60">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <TextBlock x:Name="MainSubtitleText" Text="" FontSize="30"
                                   Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="850">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TranslatedSubtitleText" Text="" FontSize="26"
                                   Foreground="#BBCCFF" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="850" Margin="0,4,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- تمام صفحه -->
                <Grid x:Name="FullscreenOverlay" IsHitTestVisible="False" Visibility="Collapsed"
                      VerticalAlignment="Bottom" Margin="0,0,0,80">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <TextBlock x:Name="FsMainSubtitle" Text="" FontSize="32"
                                   Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1200">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="FsTranslatedSubtitle" Text="" FontSize="28"
                                   Foreground="#BBCCFF" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1200" Margin="0,6,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- کنترل‌های تمام صفحه -->
                <Border x:Name="FullscreenControls" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                        Background="#CC000000" Padding="20,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FsCurrentTime" Grid.Column="0" Text="00:00:00" FontSize="12"
                                       Foreground="#AAA" VerticalAlignment="Center" FlowDirection="LeftToRight" FontFamily="Consolas"/>
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <Border Background="{StaticResource SeekBarBg}" CornerRadius="3" Height="4" VerticalAlignment="Center"/>
                                <Slider x:Name="FsPositionSlider" Minimum="0" Maximum="100" Value="0"
                                        Style="{StaticResource ModernSlider}"
                                        ValueChanged="PositionSlider_ValueChanged"
                                        PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"/>
                            </Grid>
                            <TextBlock x:Name="FsTotalTime" Grid.Column="2" Text="00:00:00" FontSize="12"
                                       Foreground="#AAA" VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="LeftToRight" FontFamily="Consolas"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📂" Style="{StaticResource CtrlBtn}" Click="OpenButton_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⏮" Style="{StaticResource CtrlBtn}" Click="PrevButton_Click"/>
                                <Button x:Name="FsPlayPause" Content="▶" Style="{StaticResource PlayBtn}" Click="PlayPauseButton_Click"/>
                                <Button Content="⏭" Style="{StaticResource CtrlBtn}" Click="NextButton_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="⚡" Style="{StaticResource CtrlBtn}" Click="SpeedBtn_Click"/>
                                <TextBlock x:Name="FsVolumeIcon" Text="🔊" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="FsVolumeSlider" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" Value="80"
                                        ValueChanged="VolumeSlider_ValueChanged" Width="120"/>
                                <Button Content="⛶" Style="{StaticResource CtrlBtn}" Click="ExitFullscreen_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- صفحه خالی (روی همه چیز) -->
            <Grid x:Name="EmptyState" Grid.ColumnSpan="2" Background="#0D0D0D"
                  IsHitTestVisible="True" Visibility="Visible"
                  MouseLeftButtonDown="EmptyState_MouseLeftButtonDown"
                  AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="80" Height="80" Margin="0,0,0,16"
                           RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9"/>
                    <TextBlock Text="Aryo Video Player" FontSize="26" FontWeight="Bold"
                               Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                    <TextBlock Text="نسخه ۱.۰" FontSize="12" Foreground="#555"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Border Background="#333" Height="1" Width="120" HorizontalAlignment="Center" Margin="0,20,0,20"/>
                    <TextBlock Text="🎬  فایل ویدیو را اینجا رها کنید" FontSize="14"
                               Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="یا  کلیک کنید تا فایل باز شود" FontSize="14"
                               Foreground="#888" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- لیست پخش -->
            <Border x:Name="PlaylistPanel" Grid.Column="1" Width="280"
                    Background="#141414" BorderBrush="#222" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1A1A1A" Padding="14,10">
                        <Grid>
                            <TextBlock Text="لیست پخش" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <Button Content="✕" Style="{StaticResource CtrlBtn}" Click="TogglePlaylist_Click" FontSize="12" Padding="5,2" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="PlaylistListBox" Grid.Row="1"
                             Background="Transparent" Foreground="#E0E0E0" BorderThickness="0"
                             MouseDoubleClick="PlaylistListBox_MouseDoubleClick"
                             KeyDown="PlaylistListBox_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlaylistItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu Background="#1E1E1E" Foreground="#CCC" BorderBrush="#333" BorderThickness="1">
                                <MenuItem Header="▶ پخش" Click="PlaylistContextMenu_Play"/>
                                <MenuItem Header="✕ حذف" Click="PlaylistContextMenu_Remove"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <Border Grid.Row="2" Background="#1A1A1A" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="＋ افزودن" Style="{StaticResource CtrlBtn}" Click="AddToPlaylist_Click" FontSize="12" ToolTip="افزودن فایل"/>
                            <Button Content="🗑" Grid.Column="1" Style="{StaticResource CtrlBtn}" Click="RemoveFromPlaylist_Click" FontSize="12" Padding="8,4" ToolTip="حذف انتخاب شده"/>
                            <Button Content="🗑 همه" Grid.Column="2" Style="{StaticResource CtrlBtn}" Click="ClearPlaylist_Click" FontSize="12" Padding="8,4" ToolTip="پاک کردن همه"/>
                            <Button Content="▲" Grid.Column="3" Style="{StaticResource CtrlBtn}" Click="MoveUp_Click" FontSize="12" Padding="8,4" ToolTip="انتقال به بالا"/>
                            <Button Content="▼" Grid.Column="4" Style="{StaticResource CtrlBtn}" Click="MoveDown_Click" FontSize="12" Padding="8,4" ToolTip="انتقال به پایین"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Background="#151515" Padding="8" BorderBrush="#222" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="💾 ذخیره لیست" Grid.Column="0" Style="{StaticResource CtrlBtn}" Click="SavePlaylist_Click" FontSize="11" ToolTip="ذخیره لیست پخش (Ctrl+Shift+S)"/>
                            <Button Content="📂 بارگذاری لیست" Grid.Column="1" Style="{StaticResource CtrlBtn}" Click="LoadPlaylist_Click" FontSize="11" ToolTip="بارگذاری لیست پخش"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== نوار کنترل پایین ===== -->
        <Border x:Name="ControlBar" Grid.Row="2" Background="#0D0D0D" Padding="16,4,16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seek Bar -->
                <Grid Grid.Row="0" Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00:00" FontSize="11"
                               Foreground="#888" VerticalAlignment="Center" FlowDirection="LeftToRight" FontFamily="Consolas"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <Border Background="{StaticResource SeekBarBg}" CornerRadius="3" Height="4" VerticalAlignment="Center"/>
                        <Slider x:Name="PositionSlider" Minimum="0" Maximum="100" Value="0"
                                Style="{StaticResource ModernSlider}"
                                ValueChanged="PositionSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"/>
                    </Grid>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00:00" FontSize="11"
                               Foreground="#888" VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="LeftToRight" FontFamily="Consolas"/>
                </Grid>

                <!-- کنترل‌های پخش -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📂" Style="{StaticResource CtrlBtn}" Click="OpenButton_Click" ToolTip="باز کردن (Ctrl+O)"/>
                        <Button x:Name="TranslateBtn" Content="🌐" Style="{StaticResource CtrlBtn}" Click="TranslateButton_Click" ToolTip="ترجمه"/>
                        <Button Content="📷" Style="{StaticResource CtrlBtn}" Click="ScreenshotButton_Click" ToolTip="عکس"/>
                        <CheckBox x:Name="DualSubCheck" Content="Dual" Foreground="#888" FontSize="11"
                                  Margin="10,0,0,0" VerticalAlignment="Center" Click="DualSubCheck_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⏮" Style="{StaticResource CtrlBtn}" Click="PrevButton_Click" ToolTip="قبلی"/>
                        <Button x:Name="PlayPauseButton" Content="▶" Style="{StaticResource PlayBtn}" Click="PlayPauseButton_Click"/>
                        <Button Content="⏭" Style="{StaticResource CtrlBtn}" Click="NextButton_Click" ToolTip="بعدی"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" Value="80"
                                ValueChanged="VolumeSlider_ValueChanged" Width="120"/>
                        <Button Content="⛶" Style="{StaticResource CtrlBtn}" Click="FullscreenButton_Click" ToolTip="تمام صفحه (F11)" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Status Bar -->
                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <TextBlock x:Name="StatusText" Text="آماده" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SubtitleStatusText" Text="" FontSize="11"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- منوی راست کلیک سفارشی -->
        <Popup x:Name="ContextMenuPopup" AllowsTransparency="True" PopupAnimation="Fade"
               Placement="MousePoint" StaysOpen="True">
            <Border Background="#1E1E1E" CornerRadius="8" Padding="4"
                    BorderBrush="#333" BorderThickness="1" MinWidth="220"
                    Effect="{StaticResource MenuShadow}">
                <StackPanel>
                    <Button Content="📂  باز کردن فایل" Click="OpenButton_Click" Style="{StaticResource ContextMenuItem}"/>
                    <Button Content="📝  افزودن زیرنویس" Click="AddSubtitleButton_Click" Style="{StaticResource ContextMenuItem}"/>
                    <Border Background="#333" Height="1" Margin="4,4"/>
                    <Button Content="📷  عکس از ویدیو" Click="ScreenshotButton_Click" Style="{StaticResource ContextMenuItem}"/>
                    <Button Content="ℹ  اطلاعات ویدیو" Click="InfoButton_Click" Style="{StaticResource ContextMenuItem}"/>
                    <Border Background="#333" Height="1" Margin="4,4"/>
                    <Button Content="⛶  تمام صفحه" Click="FullscreenButton_Click" Style="{StaticResource ContextMenuItem}"/>
                    <Button Content="❌  خروج" Click="Close_Click" Style="{StaticResource ContextMenuItem}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
